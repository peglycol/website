---
import type { CollectionEntry } from "astro:content"

type Props = { author: CollectionEntry<"authors">; bio?: string }

const { author, bio } = Astro.props
const { name, pronouns, avatar } = author.data
const blurb = bio ?? author.data.bio
---

<author-card>
  <a href="/about" tabindex="-1" aria-hidden="true">
    <img src={avatar} alt="" width="64" height="64">
  </a>
  <author-info>
    <author-name>
      <a href="/about">{name}</a>
      {pronouns && <author-pronouns>{pronouns}</author-pronouns>}
    </author-name>
    {blurb && <p>{blurb}</p>}
    <a href="/about">More about me →</a>
  </author-info>
</author-card>

<style>
  author-card {
    display: flex;
    align-items: flex-start;
    gap: var(--space-s);

    > a {
      flex-shrink: 0;
    }

    img {
      flex-shrink: 0;
      border-radius: var(--radius-full);
    }

    author-info {
      display: flex;
      flex-direction: column;

      author-name {
        font-size: var(--step-1);
        line-height: calc(var(--leading-offset) + 1em);
        font-weight: var(--font-weight-medium);
        margin-block-start: -0.2em;

        a {
          color: var(--foreground);
        }

        author-pronouns {
          margin-inline-start: var(--space-3xs);
          font-size: var(--step--1);
          font-weight: var(--font-weight-normal);
          color: var(--muted-foreground);
        }
      }

      p {
        color: var(--muted-foreground);
        margin-block-end: var(--space-3xs);
      }

      > a {
        font-size: var(--step--1);
        color: var(--muted-foreground);

        &:hover {
          color: var(--foreground);
        }
      }
    }

    @media (width < 40rem) {
      flex-direction: column;
    }
  }
</style>
