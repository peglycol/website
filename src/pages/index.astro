---
import Email from "@/assets/icons/email.svg"
import GitHub from "@/assets/icons/github.svg"
import Itch from "@/assets/icons/itch.svg"
import Link from "@/assets/icons/link.svg"
import YouTube from "@/assets/icons/youtube.svg"
import AuthorCard from "@/components/AuthorCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import type { SvgComponent } from "astro/types"
import { getEntry } from "astro:content"

const author = (await getEntry("authors", "peglycol"))!

const ICONS: Record<string, { label: string; icon: SvgComponent }> = {
  github: { label: "GitHub", icon: GitHub },
  youtube: { label: "YouTube", icon: YouTube },
  itch: { label: "itch.io", icon: Itch },
}

const links = [
  ...(author.data.mail
    ? [{ href: `mailto:${author.data.mail}`, label: "Email", icon: Email }]
    : []),
  ...Object.entries(author.data.socials ?? {})
    .filter(([key]) => key !== "website")
    .map(([key, href]) => ({
      href,
      ...(ICONS[key] ?? { label: key, icon: Link }),
    })),
]
---

<Layout>
  <MetaPage slot="head" />
  <mosaic-grid>
    <mosaic-tile data-span="wide" data-filled>
      <AuthorCard author={author} />
    </mosaic-tile>
    <mosaic-tile data-span="tall"><span>2</span></mosaic-tile>
    <mosaic-tile data-span="wide" data-filled data-grid>
      <social-grid>
        {links.map(({ href, label, icon: Icon }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} title={label}>
            <Icon aria-hidden="true" />
          </a>
        ))}
      </social-grid>
    </mosaic-tile>
    <mosaic-tile><span>3</span></mosaic-tile>
    <mosaic-tile data-span="wide"><span>4</span></mosaic-tile>
    <mosaic-tile data-span="tall"><span>5</span></mosaic-tile>
    <mosaic-tile data-span="large"><span>6</span></mosaic-tile>
  </mosaic-grid>
</Layout>

<style>
  mosaic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(9rem, auto);
    gap: var(--space-xs);
  }

  mosaic-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs);
    color: var(--muted-foreground);
    background-color: color-mix(in oklab, var(--background) 90%, transparent);
    backdrop-filter: blur(var(--blur-sm));
    border: 1.5px dashed var(--border);
    border-radius: var(--radius-xl);
    font-size: var(--step--1);
  }

  mosaic-tile[data-span="wide"] {
    grid-column: span 2;
  }

  mosaic-tile[data-span="tall"] {
    grid-row: span 2;
  }

  mosaic-tile[data-span="large"] {
    grid-column: span 2;
    grid-row: span 2;
  }

  mosaic-tile[data-filled] {
    align-items: center;
    justify-content: flex-start;
    border-style: solid;
    text-align: start;
  }

  mosaic-tile[data-grid] {
    padding: 0;
    overflow: hidden;
  }

  social-grid {
    display: grid;
    grid-template-rows: repeat(2, 1fr);
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    inline-size: 100%;
    block-size: 100%;

    a {
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--muted-foreground);

      &:hover {
        color: var(--foreground);
        background-color: color-mix(in oklab, var(--muted) 50%, transparent);
      }

      svg {
        inline-size: 2.5em;
        block-size: 2.5em;
      }
    }
  }

  @media (width < 40rem) {
    mosaic-grid {
      grid-template-columns: 1fr;
    }

    mosaic-tile[data-span] {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
