---
import AuthorCard from "@/components/AuthorCard.astro"
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
import { getEntry } from "astro:content"

const author = (await getEntry("authors", "peglycol"))!
---

<Layout>
  <MetaPage slot="head" />
  <mosaic-grid>
    <mosaic-tile data-span="wide" data-filled>
      <AuthorCard author={author} />
    </mosaic-tile>
    <mosaic-tile data-span="tall"><span>2</span></mosaic-tile>
    <mosaic-tile><span>3</span></mosaic-tile>
    <mosaic-tile data-span="wide"><span>4</span></mosaic-tile>
    <mosaic-tile data-span="large"><span>5</span></mosaic-tile>
    <mosaic-tile><span>6</span></mosaic-tile>
    <mosaic-tile><span>7</span></mosaic-tile>
  </mosaic-grid>
</Layout>

<style>
  mosaic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(9rem, auto);
    gap: var(--space-xs);
  }

  mosaic-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-xs);
    border: 1.5px dashed var(--border);
    border-radius: var(--radius-xl);
    color: var(--muted-foreground);
    font-size: var(--step--1);
  }

  mosaic-tile[data-span="wide"] {
    grid-column: span 2;
  }

  mosaic-tile[data-span="tall"] {
    grid-row: span 2;
  }

  mosaic-tile[data-span="large"] {
    grid-column: span 2;
    grid-row: span 2;
  }

  mosaic-tile[data-filled] {
    align-items: center;
    justify-content: flex-start;
    border-style: solid;
    text-align: start;
  }

  @media (width < 40rem) {
    mosaic-grid {
      grid-template-columns: 1fr;
    }

    mosaic-tile[data-span] {
      grid-column: span 1;
      grid-row: span 1;
    }
  }
</style>
